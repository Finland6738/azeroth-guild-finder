package-as: AzerothGuildFinder

# One source of truth for library versions: tools/fetch_libs.py reads this block for local development and CI;
# the BigWigs packager reads it for releases. Each entry is a whole repository at a tag.
externals:
  AzerothGuildFinder/Libs/Ace3:
    url: https://github.com/WoWUIDev/Ace3
    tag: Release-r1403
  AzerothGuildFinder/Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
    tag: v1.1.4
  AzerothGuildFinder/Libs/LibDBIcon-1.0:
    url: https://github.com/wowace-clone/LibDBIcon-1.0
    tag: v8.0.4

# The addon lives in a subfolder of the repository: the packager moves it to the top level of the package.
move-folders:
  AzerothGuildFinder/AzerothGuildFinder: AzerothGuildFinder

# What stays out of the package. The packager skips every dotfile and dot-folder (.git, .idea, .github, .gitignore, ...)
# and every file git does not track, and a pattern here is matched against the path from the repository root with *
# crossing folders. Not listed on purpose, because they must ship: LICENSE (the GPL-3.0 text, which lands inside the
# addon folder because the repository root is the package) and the OFL texts of the fonts (OFL-*.txt next to the .ttf).
# tools/check_package.py reads this file and fails if a licence would be left out or a development file would ship.
ignore:
  - Tests
  - docs
  - tools
  - .github
  - .gitignore
  - .luarc.json
  - "*.md"
